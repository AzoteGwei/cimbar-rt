# ==================== support/bit - bit-level I/O ====================
support_bit_dep = declare_dependency(
  include_directories: include_directories('bit'),
)

# ==================== support/text - string formatting ====================
support_text_dep = declare_dependency(
  include_directories: include_directories('text'),
  dependencies: fmt_dep,
)

# ==================== support/os - platform abstractions ====================
support_os_dep = declare_dependency(
  include_directories: include_directories('os'),
)

# ==================== support/display - GUI/OpenGL display ====================
support_display_dep = declare_dependency(
  include_directories: include_directories('display'),
)
